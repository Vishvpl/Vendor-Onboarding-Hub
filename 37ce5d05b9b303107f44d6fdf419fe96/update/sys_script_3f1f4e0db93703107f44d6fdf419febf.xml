        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	if (current.state.changesTo('Approved')) {

    var companyGR = new GlideRecord(
        'core_company'
    );

    companyGR.addQuery(
        'name',
        current.vendor_name
    );

    companyGR.query();

    if (!companyGR.hasNext()) {

        companyGR.initialize();

        companyGR.name =
            current.vendor_name;

        companyGR.vendor = true;

        companyGR.insert();
    }
}

})(current, previous);]]></script>
